# CENTINA OMNI-QUANT v5.0 - environment template

# Binance
BINANCE_TESTNET=True
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Runtime
CAPITAL_USDT=200
DEFAULT_MODE=PAPER
ALLOW_LIVE_AUTO=False
RISK_PARITY=False

# Storage
DB_PATH=data/cortex.db
REDIS_URL=redis://localhost:6379/0

# Notifications
# Telegram example: tgram://bot_token/chat_id
NOTIFY_URL=

# n8n webhook bridge
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
N8N_WEBHOOK_URL=http://localhost:5678
WEBHOOK_SECRET=change-me

# LLM / data providers, optional
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
KIMI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
CRYPTOPANIC_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/logs/centina.log
